rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingRecord() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsNewRecord() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && ownsNewRecord();
      allow update: if signedIn() && request.auth.uid == userId && ownsExistingRecord() && request.resource.data.ownerId == userId;
      allow list, delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if ownsExistingRecord();
      allow create: if ownsNewRecord();
      allow update: if ownsExistingRecord() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow get, list: if ownsExistingRecord();
      allow create: if ownsNewRecord();
      allow update, delete: if false;
    }

    match /adjustments/{adjustmentId} {
      allow get, list: if ownsExistingRecord();
      allow create: if ownsNewRecord();
      allow update, delete: if false;
    }

    match /smsHistory/{smsId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/smsHistory/$(smsId)) || ownsExistingRecord()
      );
      allow list: if ownsExistingRecord();
      allow create: if ownsNewRecord();
      allow update: if ownsExistingRecord() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }
  }
}
